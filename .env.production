# ──────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.production and fill in your values
# ──────────────────────────────────────────────────────────────────────

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas > Database > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/data-analogy?retryWrites=true&w=majority

# App Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# NextAuth (if you add authentication later)
# NEXTAUTH_URL=https://dataanalogy.com
# NEXTAUTH_SECRET=your-secret-key-here

# Optional: Image CDN or S3
# NEXT_PUBLIC_IMAGE_BASE_URL=https://cdn.dataanalogy.com
